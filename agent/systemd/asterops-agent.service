[Unit]
Description=AsterOps agent (Asterisk control plane bridge)
Documentation=https://asterops.dev
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/asterops-agent --config /etc/asterops/agent/config.json
Restart=always
RestartSec=10s
User=root
# Hardening
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/etc/asterisk /etc/asterops /var/lib/asterops /etc/letsencrypt
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target